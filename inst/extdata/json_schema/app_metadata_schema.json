{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "extended_shiny_thema",
    "title": "TRIA metadata schema",
    "description": "Extended Schema for .. TODO: adapt properly for roxas ai",
    "type": "object",
    "properties":
    {
        "dataset": { "$ref": "core/tria_ds_data_schema.json" },
        "authors": { "$ref": "app_author_schema.json" },
        "funding": { "$ref": "app_funding_schema.json" },
        "related": { "$ref": "app_related_schema.json" },
        "resources": {"$ref": "core/tria_resource_data_schema.json" },
        "sites": { "$ref": "app_site_schema.json" },
        "trees": { "$ref": "app_tree_schema.json" },
        "woodpieces": { "$ref": "app_woodpiece_schema.json" },
        "slides": { "$ref": "app_slide_schema.json" },
        "images": { 
          "anyOf": [
            { "$ref": "app_roxas_schema.json" },
            { "$ref": "app_roxasai_schema.json" }
          ]
        }
    },
    "required":
    [
        "dataset",
        "authors",
        "funding",
        "sites",
        "trees",
        "woodpieces",
        "slides",
        "images"
    ],
    "additionalProperties": true
}

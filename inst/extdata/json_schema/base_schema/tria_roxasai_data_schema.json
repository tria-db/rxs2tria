{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TODO:addurltoTRIAschema",
  "title": "roxas_ai_data",
  "description": "Schema for ROXAS AI image and analysis-level metadata",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "allOf": [
      { "$ref": "tria_image_data_schema.json"},
      {
        "properties": {
          "sample_type": {
            "type": ["string", "null"],
            "enum": ["", "conifer", "angiosperm"],
            "title": "Sample type",
            "description": "Description"
          },
          "rings_segmentation_model": {
            "type": ["string", "null"],
            "title": "Rings model",
            "description": "Description"
          },
          "cells_segmentation_model": {
            "type": ["string", "null"],
            "title": "Cells model",
            "description": "Description"
          },
          "cluster_dbl_cwt_threshold": {
            "type": ["number", "null"],
            "minimum": 0,
            "title": "cluster_dbl_cwt_threshold",
            "description": "Double cell wall thickness threshold [µm]"
          },
          "relwidth_cwt_integration": {
            "type": ["number", "null"],
            "minimum": 0,
            "title": "relwidth_cwt_integration",
            "description": ""
          },
          "lower_limit_cwt_iqr_multiplier": {
            "type": ["number", "null"],
            "minimum": 0,
            "title": "lower_limit_cwt_iqr_multiplier",
            "description": ""
          },
          "upper_limit_cwt_iqr_multiplier": {
            "type": ["number", "null"],
            "minimum": 0,
            "title": "upper_limit_cwt_iqr_multiplier",
            "description": ""
          },
          "opposite_cwt_ratio_limit": {
            "type": ["number", "null"],
            "minimum": 0,
            "title": "opposite_cwt_ratio_limit",
            "description": ""
          },
          "adjacent_cwt_ratio_limit": {
            "type": ["number", "null"],
            "minimum": 0,
            "title": "adjacent_cwt_ratio_limit",
            "description": ""
          },
          "reference_series": {
            "type": ["string", "null"],
            "title": "Reference series",
            "description": "Name of the reference series used as dating reference"
          }
        },
        "required": ["rings_segmentation_model", "cells_segmentation_model"]
      }
    ],
    "unevaluatedProperties": false
  }
}


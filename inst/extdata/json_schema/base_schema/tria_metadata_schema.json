{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "TODO:addurltoTRIAschema",
    "title": "TRIA metadata schema",
    "description": "Schema for ...",
    "type": "object",
    "properties":
    {
        "dataset": { "$ref": "tria_ds_data_schema.json" },
        "authors": { "$ref": "tria_author_data_schema.json" },
        "funding": { "$ref": "tria_funding_data_schema.json" },
        "related": { "$ref": "tria_related_data_schema.json" },
        "resources": { "$ref": "tria_resource_data_schema.json" },
        "sites": { "$ref": "tria_site_data_schema.json" },
        "trees": { "$ref": "tria_tree_data_schema.json" },
        "woodpieces": { "$ref": "tria_woodpiece_data_schema.json" },
        "slides": { "$ref": "tria_slide_data_schema.json" },
        "images": { 
          "anyOf": [
            { "$ref": "tria_roxas_data_schema.json" },
            { "$ref": "tria_roxasai_data_schema.json" }
          ]
        }
    },
    "required":
    [
        "dataset",
        "authors",
        "funding",
        "sites",
        "trees",
        "woodpieces",
        "slides",
        "images"
    ],
    "additionalProperties": true
}

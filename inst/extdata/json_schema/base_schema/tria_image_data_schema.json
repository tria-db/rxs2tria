{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TODO:addurltoTRIAschema",
  "title": "image_data",
  "description": "Reference only, common properties for ROXAS and ROXAS AI schemata",
  "type": "object",
  "properties": {
    "image_label": {
      "type": "string",
      "minLength": 1,
      "readOnly": true,
      "title": "Image",
      "description": "Unique image identifier"
    },
    "slide_label": {
      "type": "string",
      "minLength": 1,
      "readOnly": true,
      "title": "Slide",
      "description": "Slide identifier"
    },
    "woodpiece_label": {
      "type": "string",
      "minLength": 1,
      "readOnly": true,
      "title": "Woodpiece",
      "description": "Woodpiece identifier"
    },
    "tree_label": {
      "type": "string",
      "minLength": 1,
      "title": "Tree",
      "readOnly": true,
      "description": "Tree identifier"
    },
    "species_code": {
      "type": ["string", "null"],
      "readOnly": true,
      "title": "Species",
      "description": "Species code (change in trees table if needed)"
    },
    "site_label": {
      "type": "string",
      "minLength": 1,
      "readOnly": true,
      "title": "Site",
      "description": "Site identifier"
    },
    "band_width": {
      "type": ["number", "null"],
      "minimum": 0,
      "title": "Bandwidth",
      "description": "Width of the analysed band [µm]"
    },
    "only_ew": {
      "type": ["boolean", "null"],
      "title": "Only EW",
      "description": "Whether only earlywood was analysed"
    },
    "spatial_resolution": {
      "type": ["number", "null"],
      "title": "Spatial resolution",
      "description": "Spatial resolution [pixels/µm]"
    },
    "meas_geometry": {
      "type": ["string", "null"],
      "enum": ["", "linear", "circular"],
      "title": "Geometry",
      "description": "Sample geometry: linear or circular"
    },
    "org_img_name": {
      "type": "string",
      "minLength": 1,
      "title": "Original name",
      "description": "Original image file name"
    },
    "img_filetype": {
      "type": ["string", "null"],
      "title": "Filetype",
      "description": "Image file type/extension"
    },
    "img_size": {
      "type": ["integer", "null"],
      "minimum": 0,
      "title": "Size",
      "description": "Image file size [bytes]"
    },
    "img_width": {
      "type": ["integer", "null"],
      "minimum": 0,
      "title": "Width",
      "description": "Image width [pixels]"
    },
    "img_height": {
      "type": ["integer", "null"],
      "minimum": 0,
      "title": "Height",
      "description": "Image height [pixels]"
    },
    "img_created_at": {
      "type": ["string","null"],
      "format": "date-time",
      "title": "Image created",
      "description": "Image creation date and time"
    },
    "img_software": {
      "type": ["string", "null"],
      "title": "Scanner software",
      "description": "Software used to scan the image"
    },
    "scan_mode": {
      "type": ["string", "null"],
      "enum": ["", "RGB", "other"],
      "title": "Scan mode",
      "description": "Image colour mode (e.g. RGB)"
    },
    "software": {
      "type": "string",
      "minLength": 1,
      "enum": ["roxas", "roxas_ai"],
      "title": "Analysis sw",
      "description": "QWA analysis software used"
    },
    "sw_version": {
      "type": ["string", "null"],
      "title": "SW version",
      "description": "Software version used"
    },
    "rxs_created_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "title": "ROXAS created",
      "description": "Timestamp of the ROXAS analysis"
    },
    "outmost_year": {
      "type": ["integer", "null"],
      "title": "Outmost year",
      "description": "Calendar year of the outermost ring"
    },
    "fname_image": {
      "type": ["string", "null"],
      "title": "File image",
      "description": "Image file name"
    },
    "fname_cells": {
      "type": ["string", "null"],
      "title": "File cells",
      "description": "Cell data file name"
    },
    "fname_rings": {
      "type": ["string", "null"],
      "title": "File rings",
      "description": "Ring data file name"
    },
    "fname_settings": {
      "type": ["string", "null"],
      "title": "File Settings",
      "description": "Settings file name"
    },
    "comment": {
      "type": ["string", "null"],
      "title": "Comment",
      "description": "Free-text comment"
    }
  },
  "required": ["image_label", "slide_label", "woodpiece_label", "tree_label", 
    "site_label", "org_img_name", "software"]
}

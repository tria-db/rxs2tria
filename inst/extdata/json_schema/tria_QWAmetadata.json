{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "TODO:addurltoTRIAschema",
    "title": "TRIA metadata schema, TRIA dataset files",
    "description": "Main schema for TRIA dataset metadata in TRIA dataset files",
    "type": "object",
    "properties":
    {
        "dataset": { "$ref": "tria_dataset.json" },
        "authors": { "$ref": "tria_authors.json" },
        "funding": { "$ref": "core/funding.json" },
        "datafiles": { "$ref": "tria_datafiles.json" },
        "sites": { "$ref": "core/sites.json" },
        "trees": { "$ref": "core/trees.json" },
        "woodpieces": { "$ref": "core/woodpieces.json" },
        "slides": { "$ref": "core/slides.json" },
        "images": {
          "anyOf": [
            { "$ref": "tria_roxas.json" },
            { "$ref": "tria_roxas_ai.json" }
          ]
        }
    },
    "required":
    [
        "dataset",
        "authors",
        "funding",
        "datafiles",
        "sites",
        "trees",
        "woodpieces",
        "slides",
        "images"
    ],
    "additionalProperties": true
}

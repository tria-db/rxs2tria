{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TODO:addurltoTRIAschema",
  "title": "TRIA dataset metadata schema, submission files",
  "description": "Schema for main dataset-related data in submission files",
  "type": "array",
  "minItems": 1,
  "maxItems": 1,
  "items": {
    "type": "object",
    "allOf": [
      { "$ref": "core/dataset.json" },
      {
        "properties": {
          "ds_access": {
            "type": "string",
            "enum": ["public", "restricted"]
          },
          "ds_license": {
            "not": { "const": "All rights reserved" },
            "description": "Intended license; for restricted datasets it applies once the embargo ends and may be left empty"
          },
          "embargoed_until": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Date until which the dataset is embargoed (YYYY-MM-DD), or null if not restricted."
          }
        },
        "required": ["ds_access", "embargoed_until"]
      },
      {
        "if": {
          "properties": { "ds_access": { "const": "restricted" } }
        },
        "then": {
          "properties": { "embargoed_until": { "type": "string", "minLength": 1 } }
        },
        "else": {
          "properties": { "ds_license": { "type": "string", "minLength": 1 } }
        }
      }
    ],
    "unevaluatedProperties": false
  }
}

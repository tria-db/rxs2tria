{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "extended_shiny_thema",
    "title": "TRIA metadata schema",
    "description": "Extended Schema for ...",
    "type": "object",
    "properties":
    {
        "dataset": { "$ref": "base_schema/20251007_tria_ds_data_schema.json" },
        "authors": { "$ref": "20251007_tria_author_ext_schema.json" },
        "funding": { "$ref": "20251007_tria_funding_ext_schema.json" },
        "relresources": { "$ref": "20251007_tria_relresource_ext_schema.json" },
        "sites": { "$ref": "20251007_tria_site_ext_schema.json" },
        "trees": { "$ref": "20251007_tria_tree_ext_schema.json" },
        "woodpieces": { "$ref": "20251007_tria_woodpiece_ext_schema.json" },
        "slides": { "$ref": "20251007_tria_slide_ext_schema.json" },
        "images": { "$ref": "base_schema/20251007_tria_roxas_data_schema.json" }
    },
    "required":
    [
        "dataset",
        "authors",
        "funding",
        "sites",
        "trees",
        "woodpieces",
        "slides",
        "images"
    ],
    "additionalProperties": true
}
